# ============ LLM ============
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=

KG_EXTRACTION_MODEL=gpt-4o-mini
KG_MIN_CONFIDENCE=0.5
KG_MAX_CONCURRENCY=4
KG_ALLOW_UNKNOWN_RELATION_TYPES=false
# Optional overrides (comma-separated):
# KG_ENTITY_TYPES=Person,Organization,Company,Product,Location,Technology,Concept,Date,Event
# KG_RELATION_TYPES=WORKS_FOR,MANAGED_BY,PRODUCES,LOCATED_IN,...

# ============ Models (free, run on your computer) ============
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ============ Neo4j AuraDB ============
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=8beb1325

# ============ Storage paths ============
UPLOAD_DIR=data/uploads
FAISS_INDEX_PATH=data/faiss

# ============ Chunking ============
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ============ Retrieval ============
VECTOR_TOP_K=10
BM25_TOP_K=10
KG_TOP_K=10
RERANK_TOP_K=5
FUSION_METHOD=rrf
MIN_RELEVANCE_SCORE=0.0

ENABLE_VECTOR_RETRIEVAL=true
ENABLE_BM25=true
ENABLE_KG_RETRIEVAL=true
ENABLE_RERANKER=true

# ============ API ============
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000