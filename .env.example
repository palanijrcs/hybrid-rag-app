# ============ LLM ============
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=

# ============ Models (free, run on your computer) ============
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ============ Neo4j AuraDB ============
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# ============ Storage paths ============
UPLOAD_DIR=data/uploads
FAISS_INDEX_PATH=data/faiss

# ============ Chunking ============
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ============ Retrieval ============
VECTOR_TOP_K=10
BM25_TOP_K=10
KG_TOP_K=10
RERANK_TOP_K=5

ENABLE_VECTOR_RETRIEVAL=true
ENABLE_BM25=true
ENABLE_KG_RETRIEVAL=true
ENABLE_RERANKER=true

# ============ API ============
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000